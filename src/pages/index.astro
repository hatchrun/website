---
// SPDX-FileCopyrightText: Copyright 2026 Gamunu Balagalla <gamunu.balagalla@gmail.com>
//
// SPDX-License-Identifier: LicenseRef-hatchrun-Proprietary

// The landing page. Plain HTML and CSS: no scripts, no trackers, and the
// fonts are served from this site. The layout follows the 2026-10
// redesign in hatchrun/brand. The boot numbers come from the smoke test
// runs in hatchrun/images.

import "../styles/tokens.css";

const title = "hatchrun: self-hosted GitHub Actions runners in your own cloud";
const description =
  "hatchrun starts a new machine in your own cloud account for every GitHub Actions job and deletes it when the job ends. Open source, AGPL-3.0.";
const app = "https://app.hatchrun.io";

// Seconds since launch, t4g.medium in ap-south-1. The axis runs to the
// 71 s of the stock Ubuntu cloud image, so 29.5 s sits at 41.5%.
const scale = 71.1;
const boot = [
  { t: 0, label: "launched" },
  { t: 6.2, label: "kernel" },
  { t: 18.2, label: "agent" },
  { t: 24.0, label: "runner" },
];
const jobRunning = 29.5;
const at = (t: number) => `${((t / scale) * 100).toFixed(1)}%`;

const steps = [
  {
    title: "Install the GitHub App",
    body: "on the organization and pick the repositories.",
  },
  {
    title: "Connect your cloud.",
    body: "On AWS that is one CloudFormation stack with an IAM role, a launch template and a security group.",
  },
  {
    title: "Change runs-on.",
    body: "One label per job, from hatchrun-2cpu to hatchrun-16cpu.",
  },
];

const specs = [
  { term: "Boot", big: "29.5s", rest: "launch to the first step", note: "t4g.medium in ap-south-1" },
  { term: "Jobs per machine", big: "1", rest: "then it terminates. Nothing carries over." },
  { term: "Inbound ports", big: "0", rest: "open on runners" },
  { term: "Runner config", rest: "Just-in-time. GitHub accepts it for one job only." },
  { term: "Regions", big: "17", rest: "AWS regions supported" },
  { term: "Images", rest: "Trivy scan, SBOM and build provenance, published to every supported region." },
  { term: "Network", rest: "Your VPC and subnets. Jobs reach private databases without a tunnel." },
  { term: "Compute billing", rest: "Your provider bills you. Savings Plans and Spot apply." },
];

const repos = [
  {
    name: "hatchrun/hatchrun",
    tag: "Core",
    title: "Scaler, broker, agent",
    body: "The control plane and the agent that boots on each runner.",
    cta: "Read the code",
    href: "https://github.com/hatchrun/hatchrun",
  },
  {
    name: "hatchrun/images",
    tag: "Images",
    title: "Runner images",
    body: "The build behind the 29.5-second boot, with its scans and SBOMs.",
    cta: "Check the images",
    href: "https://github.com/hatchrun/images",
  },
  {
    name: "hatchrun/terraform-aws-hatchrun",
    tag: "Self-host",
    title: "Run it yourself",
    body: "Terraform for the whole stack in your own AWS account.",
    cta: "Self-hosting guide",
    href: "/docs/self-hosting/",
  },
];

// The metered price, as the Polar product charges it.
const rates = [
  {
    item: "hatchrun.io runners, per minute",
    price: "$0.001",
    note: "Billed per second, 60-second minimum per job. A card is required.",
  },
  {
    item: "hatchrun CI, per minute",
    price: "$0.002",
    note: "For 2 vCPU. 4, 8 and 16 vCPU cost 2x, 4x and 8x. Same subscription.",
  },
  {
    item: "Compute markup",
    price: "$0.00",
    note: "Your cloud provider bills runner instances directly.",
  },
];
const examples = [
  { minutes: "1,000", cost: "$1.00" },
  { minutes: "100,000", cost: "$100.00" },
  { minutes: "500,000", cost: "$500.00" },
];

const receipt = [
  "Image rebuilds and scans",
  "Security fixes",
  "Support",
  "Hosted control plane",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://hatchrun.io/" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://hatchrun.io/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#141517" />
  </head>
  <body>
    <div class="status mono">
      <div class="wrap status-inner">
        <span class="live"><span class="dot" aria-hidden="true"></span>Runs in your <span class="on">AWS</span> account</span>
        <span>GCP · next</span>
        <span>Azure · next</span>
        <span class="status-end">AGPL-3.0 · built in the open</span>
      </div>
    </div>

    <header class="nav">
      <nav aria-label="Main" class="wrap nav-inner">
        <a class="nav-logo" href="/" aria-label="hatchrun home">
          <img src="/brand/hatchrun-lockup-horizontal-on-light.svg" alt="hatchrun" width="177" height="34" />
        </a>
        <div class="nav-links mono">
          <a href="#how">How it works</a>
          <a href="#open">Open source</a>
          <a href="#pricing">Pricing</a>
          <a href="/docs/overview/">Docs</a>
        </div>
        <a class="nav-github mono" href="https://github.com/hatchrun">GitHub</a>
        <a class="nav-cta display" href={app}>Get started</a>
      </nav>
    </header>

    <main>
      <section id="top" class="hero">
        <div class="wrap hero-inner">
          <p class="eyebrow mono">Self-hosted GitHub Actions runners</p>
          <h1 class="display">
            Your cloud.<br /><span class="h1-mark">Your <img src="/brand/hatchrun-mark.svg" alt="" aria-hidden="true" /> runners.</span>
          </h1>
          <div class="hero-grid">
            <div class="hero-copy">
              <p class="lede">
                hatchrun runs the fleet for you. Each job gets a new machine in
                your own cloud account, and the machine is gone when the job ends.
              </p>
              <div class="actions">
                <a class="btn btn-chick display" href={app}>Get started</a>
                <a class="btn btn-bone display" href="/docs/getting-started/">Read the docs</a>
              </div>
            </div>
            <pre class="diff mono" aria-label="Workflow change"><span class="c"># .github/workflows/test.yml</span>
jobs:
  test:
<span class="del">-   runs-on: ubuntu-latest</span>
<span class="add">+   runs-on: hatchrun-4cpu-arm64</span></pre>
          </div>

          <figure class="meter">
            <figcaption class="mono">
              <span class="meter-title">Launch to first job step</span>
              <span class="fog">t4g.medium · ap-south-1</span>
            </figcaption>
            <div class="meter-row">
              <div class="meter-head mono">
                <strong>hatchrun image</strong><strong class="heat">29.5 s</strong>
              </div>
              <div class="track" style={`--done: ${at(jobRunning)}`}>
                <div class="fill"></div>
                <img class="chick" src="/brand/hatchrun-mark.svg" alt="" aria-hidden="true" />
                {boot.map((b) => <span class="tick" style={`left: ${at(b.t)}`}></span>)}
              </div>
              <ol class="ticks mono">
                {
                  boot.map((b, i) => (
                    <li style={`left: ${at(b.t)}`} class={i === boot.length - 1 ? "nudge" : undefined}>
                      {b.t.toFixed(1)}s <br />{b.label}
                    </li>
                  ))
                }
                <li class="done" style={`left: ${at(jobRunning)}`}>{jobRunning.toFixed(1)}s <br />job running</li>
              </ol>
            </div>
            <div class="meter-row">
              <div class="meter-head mono fog"><span>Ubuntu cloud image</span><span>71 s</span></div>
              <div class="stock"></div>
            </div>
          </figure>
        </div>
      </section>

      <section id="how" class="how">
        <div class="wrap band">
          <div class="head">
            <div class="head-title">
              <p class="eyebrow mono heat-bright">How it works</p>
              <h2 class="display h2">We schedule. Your account runs the job.</h2>
            </div>
            <p class="fog head-note">
              The control plane decides when to start a machine. Your code, secrets
              and build output stay on machines you own.
            </p>
          </div>

          <div class="arch">
            <div class="node">
              <span class="node-label mono">01 · GitHub</span>
              <div class="node-title display">A job is queued</div>
              <div class="kv mono">
                <span class="fog">event</span> workflow_job<br />
                <span class="fog">label</span> <span class="chick-text">hatchrun-4cpu-arm64</span><br />
                <span class="fog">repo</span> your-org/api
              </div>
              <span class="node-foot mono">The GitHub App sends the webhook.</span>
            </div>
            <div class="node">
              <span class="node-label mono">02 · hatchrun control plane</span>
              <div class="node-title display">Picks a machine</div>
              <dl class="rows mono">
                <div><dt>profile</dt><dd>4 vCPU · 16 GiB · arm64</dd></div>
                <div><dt>market</dt><dd>on-demand or spot</dd></div>
                <div><dt>runner config</dt><dd>just-in-time</dd></div>
              </dl>
              <span class="node-foot mono">Hosted by us, or self-hosted by you.</span>
            </div>
            <div class="node node-yours">
              <span class="node-label mono chick-text">03 · Your cloud account</span>
              <div class="node-title display">Runs it, then deletes it</div>
              <div class="pips">
                <div class="pip pip-running">
                  <img src="/brand/mascot/pip-running.svg" alt="" aria-hidden="true" width="48" height="48" />
                  <span class="mono">▶ RUNNING</span>
                </div>
                <div class="pip pip-passed">
                  <img src="/brand/mascot/pip-passed.svg" alt="" aria-hidden="true" width="48" height="48" />
                  <span class="mono">✓ PASSED</span>
                </div>
                <div class="pip pip-queued">
                  <img src="/brand/mascot/pip-queued.svg" alt="" aria-hidden="true" width="48" height="48" />
                  <span class="mono">••• QUEUED</span>
                </div>
              </div>
              <span class="node-foot mono">Your network, your role, your bill. No inbound ports.</span>
            </div>
          </div>

          <ol class="setup">
            {
              steps.map((s, i) => (
                <li>
                  <span class="mono setup-num">{i + 1}</span>
                  <span><strong>{s.title}</strong> <span class="fog">{s.body}</span></span>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="spec" aria-label="Spec sheet">
        <div class="wrap band split">
          <div class="spec-intro">
            <p class="eyebrow mono heat">Spec sheet</p>
            <h2 class="display h2">Self-hosted runners, minus the fleet work.</h2>
            <p class="ink-2">
              The numbers we hold ourselves to. If one slips, that is a bug, and the
              issue tracker is public.
            </p>
            <img class="spec-pip" src="/brand/mascot/pip-idle.svg" alt="Pip, the hatchrun chick" width="160" height="160" />
          </div>
          <dl class="sheet">
            {
              specs.map((s) => (
                <div>
                  <dt class="mono">{s.term}</dt>
                  <dd>
                    {s.big ? (
                      <>
                        <span class="big display">{s.big}</span> <span class="fog">{s.rest}</span>
                        {s.note && <span class="note mono">{s.note}</span>}
                      </>
                    ) : (
                      s.rest
                    )}
                  </dd>
                </div>
              ))
            }
            <div class="last">
              <dt class="mono">Clouds</dt>
              <dd class="clouds mono">
                <span class="cloud-on">AWS</span>
                <span class="cloud-next">GCP next</span>
                <span class="cloud-next">Azure next</span>
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <section id="open" class="open">
        <div class="wrap band">
          <div class="head">
            <div class="head-title">
              <p class="eyebrow mono passed">Open source · AGPL-3.0</p>
              <h2 class="display h2-big">Built in the open.</h2>
            </div>
            <p class="ink-2 head-note">
              You can read every line that touches your cloud account. The roadmap
              and the GCP and Azure work are public issues. If you would rather run
              all of it yourself, you can.
            </p>
          </div>
          <div class="repos">
            {
              repos.map((r) => (
                <a class="repo" href={r.href}>
                  <div class="repo-top mono">
                    <span>{r.name}</span>
                    <span class="repo-tag">{r.tag}</span>
                  </div>
                  <div class="repo-body">
                    <div class="repo-title display">{r.title}</div>
                    <div class="ink-2 repo-text">{r.body}</div>
                  </div>
                  <div class="repo-cta mono">{r.cta} →</div>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section id="pricing" class="pricing">
        <div class="wrap band split">
          <div class="pricing-copy">
            <p class="eyebrow mono heat">Pricing</p>
            <h2 class="display h2-big">The code is free. The service is cheap.</h2>
            <p class="ink-2">
              Hosted hatchrun is billed per second, with a 60-second minimum per job,
              per GitHub organization. Runners and hatchrun CI share one
              subscription, each at its own rate. There are no free minutes, so an
              organization adds a card before its first job. Your cloud provider
              bills you for runner instances at your own rates, and we never mark
              up compute.
            </p>
            <div class="selfhost">
              <div>
                <div class="display selfhost-title">Self-hosted</div>
                <div class="ink-2 small">Same code, run by you. You patch the images.</div>
              </div>
              <div class="selfhost-price">
                <span class="display">$0</span>
                <a class="btn-small display" href="/docs/self-hosting/">Guide</a>
              </div>
            </div>
            <p class="mono fog example">
              AWS example: c7g.large is $0.0725 an hour, so a ten-minute job costs
              about 1.2¢ in compute.
            </p>
          </div>

          <div class="receipt-wrap">
            <div class="receipt mono">
              <div class="receipt-head">
                <img src="/brand/hatchrun-mark-micro.svg" alt="" aria-hidden="true" width="44" height="44" />
                <div class="display receipt-name">hatchrun</div>
                <div class="label">One plan, per GitHub organization</div>
              </div>
              <hr />
              <div class="label">Each month</div>
              <ul>
                {rates.map((rate) => (
                  <li class="rate">
                    <div><span>{rate.item}</span><span>{rate.price}</span></div>
                    <div class="note">{rate.note}</div>
                  </li>
                ))}
              </ul>
              <hr />
              <div class="label">Where your money goes</div>
              <ul>
                {receipt.map((line) => <li><span>{line}</span><span>✓</span></li>)}
                <li class="coffee"><span>The maintainer's coffee</span><span>✓</span></li>
              </ul>
              <hr />
              <div class="label">Example month, billable runner minutes, each job at least 60 seconds</div>
              <ul>
                {examples.map((example) => (
                  <li class="fog"><span>{example.minutes} billable minutes</span><span>{example.cost}</span></li>
                ))}
              </ul>
              <div class="total">
                <span class="display">25,000 min</span>
                <span><span class="display amount">$25.00</span></span>
              </div>
              <div class="yearly">25,000 billable minutes x $0.001</div>
              <div class="note">
                Large volume, invoicing or an SLA?{" "}
                <a href="mailto:support@hatchrun.io">Talk to us</a>.
              </div>
              <a class="btn btn-chick display receipt-cta" href={app}>Get started</a>
              <div class="thanks">THANK YOU FOR FUNDING OPEN SOURCE</div>
            </div>
            <div class="tear" aria-hidden="true"></div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div class="cta">
          <h2 class="display h2-big">Change one line. <span class="chick-text">Hatch a runner.</span></h2>
          <a class="btn btn-chick-flat display" href={app}>Get started</a>
        </div>
        <div class="footer-meta mono">
          <img src="/brand/hatchrun-lockup-horizontal-on-dark.svg" alt="hatchrun" width="146" height="28" />
          <nav aria-label="Footer">
            <a href="/docs/overview/">Docs</a>
            <a href="/docs/security/">Security</a>
            <a href="/docs/roadmap/">Roadmap</a>
            <a href="https://github.com/hatchrun">GitHub</a>
            <a href="mailto:support@hatchrun.io">support@hatchrun.io</a>
          </nav>
          <p>hatchrun is AGPL-3.0 · Not affiliated with GitHub, AWS, Google Cloud or Microsoft Azure.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--hr-bone);
    color: var(--hr-ink);
    font-family: var(--hr-font-display);
    font-size: 17px;
    line-height: 1.55;
    overflow-x: hidden;
  }

  a {
    color: var(--hr-ink);
    text-decoration: none;
  }

  a:hover {
    color: var(--hr-ink-heat);
  }

  a:focus-visible {
    outline: 3px solid var(--hr-heat);
    outline-offset: 3px;
  }

  img {
    display: block;
  }

  h1,
  h2,
  p,
  dl,
  dd,
  figure,
  ol,
  ul {
    margin: 0;
  }

  ol,
  ul {
    padding: 0;
    list-style: none;
  }

  .wrap {
    max-width: 1320px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  .mono {
    font-family: var(--hr-font-mono);
  }

  .display {
    font-family: var(--hr-font-display);
    font-weight: 800;
    font-stretch: 125%;
    text-transform: uppercase;
  }

  .eyebrow {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hr-ink-fog);
  }

  .fog {
    color: var(--hr-ink-fog);
  }
  .ink-2 {
    color: var(--hr-ink-2);
  }
  .heat {
    color: var(--hr-ink-heat);
  }
  .heat-bright {
    color: var(--hr-heat);
  }
  .passed {
    color: var(--hr-ink-passed);
  }
  .chick-text {
    color: var(--hr-chick);
  }

  .h2 {
    font-weight: 900;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 0.95;
  }

  .h2-big {
    font-weight: 900;
    font-size: clamp(40px, 5.4vw, 76px);
    line-height: 0.92;
  }

  .band {
    padding-top: 104px;
    padding-bottom: 104px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 48px;
    align-items: start;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
  }

  .head-title {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 760px;
  }

  .head-note {
    max-width: 440px;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    font-size: 15px;
    padding: 17px 26px;
    border-radius: 4px;
    border: 2px solid var(--hr-ink);
    color: var(--hr-ink);
  }

  .btn-chick {
    background: var(--hr-chick);
    box-shadow: 4px 4px 0 var(--hr-ink);
  }

  .btn-chick:hover {
    color: var(--hr-ink);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--hr-ink);
  }

  .btn-bone {
    background: var(--hr-bone);
    padding-left: 24px;
    padding-right: 24px;
  }

  .btn-bone:hover {
    background: var(--hr-paper);
  }

  /* Status strip */
  .status {
    background: var(--hr-graphite);
    color: var(--hr-fog);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .status-inner {
    padding-top: 9px;
    padding-bottom: 9px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    align-items: center;
  }

  .live {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--hr-passed);
  }

  .on {
    color: var(--hr-bone);
  }

  .status-end {
    margin-left: auto;
  }

  /* Nav */
  .nav {
    border-bottom: 2px solid var(--hr-ink);
  }

  .nav-inner {
    padding-top: 16px;
    padding-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 32px;
  }

  .nav-logo img {
    height: 34px;
    width: auto;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    flex: 1 1 auto;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nav-links a {
    padding: 10px 0;
  }

  .nav-github {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 2px solid var(--hr-ink);
    padding: 10px 14px;
    border-radius: 4px;
  }

  .nav-cta {
    background: var(--hr-graphite);
    color: var(--hr-chick);
    font-size: 14px;
    padding: 13px 20px;
    border-radius: 4px;
  }

  .nav-cta:hover {
    color: var(--hr-bone);
  }

  /* Hero */
  .hero {
    background-color: var(--hr-bone);
    background-image:
      linear-gradient(rgba(20, 21, 23, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(20, 21, 23, 0.07) 1px, transparent 1px);
    background-size: 48px 48px;
    border-bottom: 2px solid var(--hr-ink);
  }

  .hero-inner {
    padding-top: 72px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* The drawn size (10.5vw, up to 156px) does not fit "Your runners."
     on one line at wdth 125, so the size follows the line's real width:
     it is about 12.1em wide. On a phone the words wrap. */
  .hero h1 {
    font-weight: 900;
    font-size: clamp(44px, 7.1vw, 102px);
    line-height: 0.86;
